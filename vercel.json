{
  "version": 2,
  "public": false,
  "rewrites": [
    { "source": "/", "destination": "/src/index.html" },
    { "source": "/data/:path*", "destination": "/data/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
